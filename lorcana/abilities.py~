        for c in top:
            pl.deck.insert(0, c)

    elif name == "Under the Sea":
        for ch in list(g.my_chars(opp)):
            if g.eff_strength(ch) <= 2:
                del g.chars[ch.uid]
                g.players[opp].deck.insert(0, ch.card)
                for u in ch.under:
