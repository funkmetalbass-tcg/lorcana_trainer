    if name == "Like A Bird In the Sky":
        mine = [c for c in g.my_chars(p)]
        if mine:
            tgt = max(mine, key=lambda c: g.eff_lore(c))
            g.effects.append({"kind": "lore", "target": tgt.uid,
                              "amount": 1, "until": p})
            g.effects.append({"kind": "evasive", "target": tgt.uid,
                              "amount": 0, "until": p})
