        return

    # ---- Songs / actions ----
    if name == "Strength of a Raging Fire":
        tgt = _best_opp_char(g, p)
        if tgt:
            g.deal_damage(tgt, len(g.my_chars(p)))
        return

    if name == "He Hurled His Thunderbolt":
        tgt = _best_opp_char(g, p)
        if tgt:
            g.deal_damage(tgt, 4)
        for c in g.my_chars(p):
            if "Deity" in c.card.classifications:
